nsformation: subtract each entity's mean","skillIds":["panel.random-effects"],"estimatedMinutes":6,"difficulty":"advanced","points":5},{"id":"panel-fixed-effects-02","index":13,"moduleId":"panel-fixed-effects","moduleIndex":1,"type":"code","title":"Method A — entity dummies","skillIds":["panel.hausman"],"estimatedMinutes":10,"difficulty":"advanced","points":10},{"id":"panel-fixed-effects-03","index":14,"moduleId":"panel-fixed-effects","moduleIndex":2,"type":"code","title":"Method B — demean by hand, then OLS","skillIds":["panel.random-effects"],"estimatedMinutes":10,"difficulty":"advanced","points":10},{"id":"panel-fixed-effects-04","index":15,"moduleId":"panel-fixed-effects","moduleIndex":3,"type":"interactive","title":"Slider: pooled drifts, fixed effects holds","skillIds":["panel.hausman"],"estimatedMinutes":8,"difficulty":"advanced","points":10},{"id":"panel-fixed-effects-05","index":16,"moduleId":"panel-fixed-effects","moduleIndex":4,"type":"quiz","title":"Check: why no constant?","skillIds":["panel.random-effects"],"estimatedMinutes":5,"difficulty":"advanced","points":15},{"id":"panel-fixed-effects-06","index":17,"moduleId":"panel-fixed-effects","moduleIndex":5,"type":"quiz","title":"Check: what FE cannot estimate","skillIds":["panel.hausman"],"estimatedMinutes":5,"difficulty":"advanced","points":15},{"id":"panel-fixed-effects-07","index":18,"moduleId":"panel-fixed-effects","moduleIndex":6,"type":"fillblank","title":"Name the transformation","skillIds":["panel.random-effects"],"estimatedMinutes":4,"difficulty":"advanced","points":15},{"id":"panel-fixed-effects-08","index":19,"moduleId":"panel-fixed-effects","moduleIndex":7,"type":"truefalse","title":"Can FE price a fixed trait?","skillIds":["panel.hausman"],"estimatedMinutes":3,"difficulty":"advanced","points":10},{"id":"panel-fixed-effects-09","index":20,"moduleId":"panel-fixed-effects","moduleIndex":8,"type":"truefalse","title":"Smaller SEs, so use RE?","skillIds":["panel.random-effects"],"estimatedMinutes":