ic-panel"],"estimatedMinutes":5,"difficulty":"advanced","points":15},{"id":"panel-random-effects-08","index":28,"moduleId":"panel-random-effects","moduleIndex":7,"type":"quiz","title":"Hausman rejects RE — now what?","skillIds":["panel.dynamic-panel"],"estimatedMinutes":5,"difficulty":"advanced","points":15},{"id":"panel-random-effects-09","index":29,"moduleId":"panel-random-effects","moduleIndex":8,"type":"truefalse","title":"RE by default?","skillIds":["panel.dynamic-panel"],"estimatedMinutes":3,"difficulty":"advanced","points":10}]}]}
