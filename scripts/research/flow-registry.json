    "version": 1,
    "hash": "58c47b52126a134316e17773967383014549bf195243f131b7b3ad9cec925a94"
  },
  "protocol": {
    "returnStartsAt": "flag-publication",
    "fit": "past-only",
    "universe": "as-of-date",
    "pooling": "never-live-with-reconstruction",
    "evaluationSample": "all-name-days-of-the-universe-as-of-each-date"
  },
  "multiplicity": {
    "family": "all-tests-per-regime",
    "procedure": "benjamini-hochberg",
    "q": 0.05,
    "size": 30,
    "primary": {
      "test": "S1.next",
      "procedure": "holm",
      "family": [
        "S1.close",
        "S1.next",
        "S1.h5"
      ],
      "alpha": 0.05
    }
  },
  "trials": {
    "logged": true,
    "rule": "every trial is a row of this registry or of a later version; none is run unregistered"
  },
  "signals": [
    {
      "id": "S1",
      "name": "Alert activity",
      "reconstructible": true,
      "direction": "unsigned",
      "kind": "own",
      "input": "membership of the Alert tier of the flow radar in the name's session"
    },
    {
      "id": "S2",
      "name": "Screen activity",
      "reconstructible": true,
      "direction": "unsigned",
      "kind": "own",
      "input": "membership of the Screen tier of the flow radar in the name's session"
    },
    {
      "id": "S3",
      "name": "Alert direction with sign",
      "reconstructible": true,
      "direction": "signed",
      "kind": "own",
      "input": "the sign of the premium imbalance of an Alert, bullish or bearish by the convention of the product"
    },
    {
      "id": "S4",
      "name": "Burst on vendor alerts",
      "reconstructible": true,
      "direction": "unsigned",
      "kind": "own",
      "input": "a burst of the vendor's flow alerts for the name, beyond self-excitation"
    },
    {
      "id": "S4p",
      "name": "Burst on large prints",
      "reconstructible": true,
      "direction": "unsigned",
      "kind": "own",
      "input": "a burst of large option prints for the name, from the full print feed"
    },
    {
      "id": "S5",
      "name": "Flow turned",
      "reconstructible": true,
      "direction": "signed",
      "kind": "own",
      "input": "a turn of the sign of the flow imbalance, with the false-turn budget printed"
    },
    {
      "id": "S6",
      "name": "Live opening bound",
      "reconstructible": true,
      "direction": "unsigned",
      "kind": "own",
      "input": "the arithmetic bound on the day's opening volume from the first minutes of the live print feed"
    },
    {
      "id": "S7",
      "name": "Vendor sweep and volume over open interest",
      "reconstructible": true,
      "direction": "unsigned",
      "kind": "benchmark",
      "input": "the vendor's own sweep-and-volume-over-open-interest rule"
    },
    {
      "id": "S8",
      "name": "Vendor unusual preset",
      "reconstructible": true,
      "direction": "unsigned",
      "kind": "benchmark",
      "input": "the vendor's own unusual preset"
    },
    {
      "id": "S10",
      "name": "Contract-level unusual volume",
      "reconstructible": true,
      "direction": "unsigned",
      "kind": "own",
      "input": "unusual volume of a single contract against its own sampling noise"
    }
  ],
  "horizons": [
    {
      "id": "close",
      "sessions": 1,
      "window": "flag-publication to the close of the flag's session",
      "h": 1,
      "start": "flag publication",
      "note": "the window is shorter than a session and the h1 threshold is not scaled down, so the event is rarer than its nominal rate"
    },
    {
      "id": "next",
      "sessions": 1,
      "window": "close of the flag's session to the next session's close",
      "h": 1,
      "start": "issue close",
      "note": "exactly the h1 definition"
    },
    {
      "id": "h5",
      "sessions": 5,
      "window": "close of the flag's session to the fifth session's close",
      "h": 5,
      "start": "issue close",
      "note": "exactly the h5 definition"
    }
  ],
